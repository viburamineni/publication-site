{
  "name": "publication-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run clean:generated && astro build && tsx scripts/write-redirects.ts && pagefind --site dist && npm run check:generated",
    "build:test": "PUBLICATION_USE_FIXTURES=true PUBLIC_SITE_URL=https://example.pages.dev npm run build",
    "check:generated": "tsx scripts/check-generated-files.ts",
    "clean:generated": "tsx scripts/clean-generated.ts",
    "contentful:migrate": "npx --yes contentful-migration@5.1.0 --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/001-initial-model.cjs",
    "contentful:export": "tsx scripts/export-content-model.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify:links": "tsx scripts/verify-links.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build:test",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@contentful/rich-text-types": "^17.2.7",
    "astro": "^7.1.4",
    "contentful": "^11.12.7",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "contentful-management": "^12.10.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}

{
  "name": "publication-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run clean:generated && astro build && tsx scripts/copy-generated-images.ts && tsx scripts/write-redirects.ts && tsx scripts/pagefind-anchor.ts create && pagefind --site dist && tsx scripts/pagefind-anchor.ts remove && npm run check:generated",
    "build:test": "PUBLICATION_USE_FIXTURES=true PUBLIC_SITE_URL=https://example.pages.dev npm run build",
    "check:generated": "tsx scripts/check-generated-files.ts",
    "clean:generated": "tsx scripts/clean-generated.ts",
    "contentful:migrate": "contentful-migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/001-initial-model.cjs",
    "contentful:migrate:remove-editorial-state": "contentful-migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/002-remove-editorial-state.cjs",
    "contentful:migrate:validate-previous-slugs": "contentful-migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/003-validate-previous-slugs.cjs",
    "contentful:migrate:publishing-checks": "contentful-migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/004-add-publishing-checks.cjs",
    "contentful:migrate:story-labels": "contentful-migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/005-simplify-story-labels.cjs",
    "contentful:migrate:homepage-controls": "contentful-migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/006-clean-homepage-controls.cjs",
    "contentful:migrate:remove-publishing-marker": "contentful-migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/007-remove-client-readiness-marker.cjs",
    "contentful:migrate:protect-internal-notes": "contentful-migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT:-master}\" --access-token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --yes contentful/migrations/008-protect-internal-notes.cjs",
    "contentful:app:dev": "vite --config contentful/apps/publishing-checks/vite.config.ts --host 127.0.0.1 --port 3000",
    "contentful:app:build": "vite build --config contentful/apps/publishing-checks/vite.config.ts",
    "contentful:app:upload": "npm run contentful:app:build && contentful-app-scripts upload --ci --bundle-dir contentful/apps/publishing-checks/dist --organization-id \"$CONTENTFUL_ORGANIZATION_ID\" --definition-id \"$CONTENTFUL_APP_DEF_ID\" --token \"$CONTENTFUL_MANAGEMENT_TOKEN\" --comment \"Publishing checks\"",
    "contentful:seed": "tsx scripts/seed-contentful.ts seed",
    "contentful:smoke:publish": "tsx scripts/seed-contentful.ts publish-test",
    "contentful:smoke:unpublish": "tsx scripts/seed-contentful.ts unpublish-test",
    "contentful:export": "tsx scripts/export-content-model.ts",
    "contentful:export:story-labels": "tsx scripts/project-story-label-model.ts",
    "contentful:export:homepage-controls": "tsx scripts/project-homepage-controls-model.ts",
    "contentful:export:publishing-checks": "tsx scripts/project-publishing-checks-model.ts",
    "contentful:export:internal-notes": "tsx scripts/project-internal-notes-model.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify:links": "tsx scripts/verify-links.ts",
    "deploy:worker": "wrangler deploy",
    "deploy:worker:dry-run": "wrangler deploy --dry-run",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run contentful:app:build && npm run build:test",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@contentful/rich-text-types": "^17.2.7",
    "astro": "^7.1.6",
    "contentful": "^11.12.7",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@contentful/app-scripts": "4.1.6",
    "@contentful/app-sdk": "^4.68.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "contentful-migration": "5.1.0",
    "contentful-management": "^12.13.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}

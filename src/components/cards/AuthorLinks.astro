---
import type { Author } from '../../contentful/types';

interface Props {
  authors: Author[];
}

const { authors } = Astro.props;
---

<span class="author-links">
  {
    authors.map((author, index) => (
      <span>
        {index > 0 && (index === authors.length - 1 ? ' and ' : ', ')}
        <a href={`/authors/${author.slug}/`}>{author.name}</a>
      </span>
    ))
  }
</span>

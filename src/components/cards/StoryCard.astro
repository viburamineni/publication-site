---
import type { Article, Author, Category } from '../../contentful/types';
import ResponsiveImage from '../layout/ResponsiveImage.astro';
import { formatPublicationDate } from '../../utilities/content';

interface Props {
  article: Article;
  authors: Author[];
  category?: Category | undefined;
}

const { article, authors, category } = Astro.props;
---

<article class="story-card">
  {
    article.heroImage && (
      <figure class="story-image">
        <a href={`/articles/${article.slug}/`} tabindex="-1" aria-hidden="true">
          <ResponsiveImage
            image={article.heroImage}
            sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 30vw"
          />
        </a>
      </figure>
    )
  }
  <div class="story-meta">
    <span>{article.articleType}</span>
    {category && <span>{category.name}</span>}
    <time datetime={article.publicationDate}>{formatPublicationDate(article.publicationDate)}</time>
  </div>
  <h3 class="card-title">
    <a href={`/articles/${article.slug}/`}>{article.title}</a>
  </h3>
  <p class="card-dek">{article.dek}</p>
  <p class="card-byline">By {authors.map((author) => author.name).join(' and ')}</p>
</article>

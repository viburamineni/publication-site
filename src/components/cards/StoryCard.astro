---
import type { Article, Author, Category } from '../../contentful/types';
import ResponsiveImage from '../layout/ResponsiveImage.astro';
import AuthorLinks from './AuthorLinks.astro';
import {
  displayStoryLabel,
  distinctCategoryLabel,
  formatPublicationDate,
} from '../../utilities/content';

interface Props {
  article: Article;
  authors: Author[];
  category?: Category | undefined;
}

const { article, authors, category } = Astro.props;
const storyLabel = displayStoryLabel(article.storyLabel);
const categoryLabel = distinctCategoryLabel(article.storyLabel, category?.name);
---

<article class="story-card">
  {
    article.heroImage && (
      <figure class="story-image">
        <a href={`/articles/${article.slug}/`} tabindex="-1" aria-hidden="true">
          <ResponsiveImage
            image={article.heroImage}
            sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 30vw"
          />
        </a>
      </figure>
    )
  }
  <div class="story-meta">
    {storyLabel && <span>{storyLabel}</span>}
    {categoryLabel && <span>{categoryLabel}</span>}
    <time datetime={article.publicationDate}>{formatPublicationDate(article.publicationDate)}</time>
  </div>
  <h3 class="card-title">
    <a href={`/articles/${article.slug}/`}>{article.title}</a>
  </h3>
  <p class="card-dek">{article.dek}</p>
  <p class="card-byline">
    By <AuthorLinks authors={authors} />
  </p>
</article>

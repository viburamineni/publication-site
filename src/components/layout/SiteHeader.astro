---
import type { Category, SiteSettings } from '../../contentful/types';

interface Props {
  settings: SiteSettings;
  categories: Category[];
  announcement?: string;
}

const { settings, categories, announcement = '' } = Astro.props;
const date = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date());
const currentPath = Astro.url.pathname;
const isCurrent = (url: string) => currentPath === url || currentPath.startsWith(url);
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="site-header">
  <div class="page-shell utility-row">
    <span>{date}</span>
    <nav class="utility-actions" aria-label="Edition tools">
      <a href="/topics/" aria-current={isCurrent('/topics/') ? 'page' : undefined}>Topics</a>
      <a href="/search/" aria-current={isCurrent('/search/') ? 'page' : undefined}>
        Search the edition
      </a>
    </nav>
  </div>
  <div class="page-shell masthead">
    <div class="masthead-identity">
      <a class="masthead-name" href="/" aria-label={`${settings.publicationName} home`}>
        {settings.publicationName}
      </a>
    </div>
    <p class="masthead-tagline">{settings.tagline}</p>
  </div>
</header>
<nav class="primary-nav desktop-nav" aria-label="Primary">
  <ul class="page-shell nav-list">
    {
      categories.map((category) => (
        <li>
          <a
            href={`/categories/${category.slug}/`}
            aria-current={isCurrent(`/categories/${category.slug}/`) ? 'page' : undefined}
          >
            {category.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<nav class="primary-nav mobile-nav" aria-label="Mobile primary">
  <details class="page-shell">
    <summary>Sections</summary>
    <ul class="nav-list">
      <li>
        <a href="/topics/" aria-current={isCurrent('/topics/') ? 'page' : undefined}>Topics</a>
      </li>
      {
        categories.map((category) => (
          <li>
            <a
              href={`/categories/${category.slug}/`}
              aria-current={isCurrent(`/categories/${category.slug}/`) ? 'page' : undefined}
            >
              {category.name}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>
{
  announcement && (
    <aside class="announcement" aria-label="Edition notice">
      <div class="page-shell announcement-inner">
        <strong>Notice</strong>
        <span>{announcement}</span>
      </div>
    </aside>
  )
}

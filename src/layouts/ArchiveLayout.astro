---
import BaseLayout from './BaseLayout.astro';
import ArchiveRow from '../components/cards/ArchiveRow.astro';
import EmptyState from '../components/layout/EmptyState.astro';
import type { Article } from '../contentful/types';
import { indexes } from '../contentful/data';

interface Props {
  title: string;
  description: string;
  articles: Article[];
}

const { title, description, articles } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <header class="page-shell page-header">
    <h1 class="page-title">{title}</h1>
    <p class="page-description">{description}</p>
  </header>
  <section class="page-shell archive-list" aria-label={`${title} stories`}>
    {
      articles.length > 0 ? (
        articles.map((article) => (
          <ArchiveRow
            article={article}
            authors={article.authorIds
              .map((id) => indexes.authors.get(id))
              .filter((author) => author !== undefined)}
            category={indexes.categories.get(article.primaryCategoryId)}
          />
        ))
      ) : (
        <EmptyState />
      )
    }
  </section>
</BaseLayout>

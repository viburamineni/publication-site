---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/layout/ResponsiveImage.astro';
import StoryCard from '../components/cards/StoryCard.astro';
import AuthorLinks from '../components/cards/AuthorLinks.astro';
import EmptyState from '../components/layout/EmptyState.astro';
import { publication, indexes } from '../contentful/data';
import { displayStoryLabel, distinctCategoryLabel, publishedArticles } from '../utilities/content';
import { selectHomepageContent } from '../utilities/homepage';

const articles = publishedArticles(publication);
const homepageSelection = selectHomepageContent(publication.homepage, articles, publication.topics);
const chosenLead = homepageSelection.leadArticleId
  ? indexes.articles.get(homepageSelection.leadArticleId)
  : undefined;
const lead = chosenLead ?? articles[0];
const secondary = homepageSelection.editorPickIds
  .map((id) => indexes.articles.get(id))
  .filter((article) => article !== undefined)
  .slice(0, 3);
const latest = articles.filter((article) => article.id !== lead?.id).slice(0, 5);
const featuredTopic = homepageSelection.featuredTopicId
  ? indexes.topics.get(homepageSelection.featuredTopicId)
  : undefined;
const leadAuthors = lead
  ? lead.authorIds.map((id) => indexes.authors.get(id)).filter((author) => author !== undefined)
  : [];
const leadCategory = lead ? indexes.categories.get(lead.primaryCategoryId) : undefined;
const leadStoryLabel = lead ? displayStoryLabel(lead.storyLabel) : undefined;
const leadCategoryLabel = lead
  ? distinctCategoryLabel(lead.storyLabel, leadCategory?.name)
  : undefined;

const sections = [
  {
    title: 'Analysis',
    slug: 'analysis',
    description: 'Evidence, context, and the forces underneath the day’s events.',
    articleIds: homepageSelection.analysisIds,
  },
  {
    title: 'Opinion',
    slug: 'opinion',
    description: 'Columns and arguments from staff and guest writers.',
    articleIds: homepageSelection.opinionIds,
  },
  {
    title: 'Books',
    slug: 'books',
    description: 'Reviews and criticism that treat books as part of public life.',
    articleIds: homepageSelection.reviewIds,
  },
].map((section) => ({
  ...section,
  articles: section.articleIds
    .map((id) => indexes.articles.get(id))
    .filter((article) => article !== undefined),
}));
---

<BaseLayout announcement={publication.homepage.announcement}>
  {
    lead ? (
      <section
        class:list={['page-shell', 'front-page', { 'front-page--solo': latest.length === 0 }]}
        aria-labelledby="lead-story"
      >
        <div class="lead-copy">
          {(leadStoryLabel || leadCategoryLabel) && (
            <p class="story-kicker">
              {leadStoryLabel}
              {leadStoryLabel && leadCategoryLabel ? ' · ' : ''}
              {leadCategoryLabel}
            </p>
          )}
          <h1 class="lead-title" id="lead-story">
            <a href={`/articles/${lead.slug}/`}>{lead.title}</a>
          </h1>
          <p class="lead-dek">{lead.dek}</p>
          <p class="lead-byline">
            By <AuthorLinks authors={leadAuthors} />
          </p>
        </div>
        {lead.heroImage && (
          <figure class="lead-art">
            <a href={`/articles/${lead.slug}/`} tabindex="-1" aria-hidden="true">
              <ResponsiveImage
                image={lead.heroImage}
                eager={true}
                sizes="(max-width: 900px) 100vw, 62vw"
              />
            </a>
            <figcaption>
              {lead.heroImage.caption} <span>Credit: {lead.heroImage.credit}</span>
            </figcaption>
          </figure>
        )}
        {latest.length > 0 && (
          <aside class="latest-rail" aria-labelledby="latest-heading">
            <header>
              <h2 id="latest-heading">Latest</h2>
              <a href="/latest/">All stories</a>
            </header>
            <ol class="latest-list">
              {latest.map((article) => {
                const category = indexes.categories.get(article.primaryCategoryId);
                const storyLabel = displayStoryLabel(article.storyLabel);
                const categoryLabel = distinctCategoryLabel(article.storyLabel, category?.name);
                return (
                  <li class="latest-item">
                    <div class="story-meta">
                      {storyLabel && <span>{storyLabel}</span>}
                      {categoryLabel && <span>{categoryLabel}</span>}
                    </div>
                    <h3>
                      <a href={`/articles/${article.slug}/`}>{article.title}</a>
                    </h3>
                  </li>
                );
              })}
            </ol>
          </aside>
        )}
      </section>
    ) : (
      <section class="page-shell page-header">
        <h1 class="page-title">{publication.settings.publicationName}</h1>
        <EmptyState />
      </section>
    )
  }

  {
    secondary.length > 0 && (
      <section class="section-band">
        <div class="page-shell">
          <div class="section-intro">
            <h2 class="section-title">Editor’s picks</h2>
            <p>More reporting from across today’s edition.</p>
          </div>
          <div class="story-grid">
            {secondary.map((article) => (
              <StoryCard
                article={article}
                authors={article.authorIds
                  .map((id) => indexes.authors.get(id))
                  .filter((author) => author !== undefined)}
                category={indexes.categories.get(article.primaryCategoryId)}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    sections.map(
      (section) =>
        section.articles.length > 0 && (
          <section class="section-band" aria-labelledby={`${section.slug}-section-heading`}>
            <div class="page-shell">
              <div class="section-intro">
                <div class="section-heading">
                  <h2 class="section-title" id={`${section.slug}-section-heading`}>
                    {section.title}
                  </h2>
                  <a class="section-archive-link" href={`/${section.slug}/`}>
                    All {section.title}
                  </a>
                </div>
                <p>{section.description}</p>
              </div>
              <div class="story-grid">
                {section.articles.map((article) => (
                  <StoryCard
                    article={article}
                    authors={article.authorIds
                      .map((id) => indexes.authors.get(id))
                      .filter((author) => author !== undefined)}
                    category={indexes.categories.get(article.primaryCategoryId)}
                  />
                ))}
              </div>
            </div>
          </section>
        ),
    )
  }

  {
    featuredTopic && (
      <section class="section-band">
        <div class="page-shell topic-feature">
          {featuredTopic.heroImage && (
            <figure>
              <ResponsiveImage
                image={featuredTopic.heroImage}
                sizes="(max-width: 900px) 100vw, 55vw"
              />
            </figure>
          )}
          <div class="topic-copy">
            <p class="story-kicker">Topic</p>
            <h2>{featuredTopic.name}</h2>
            <p>{featuredTopic.summary}</p>
            <a class="text-action" href={`/topics/${featuredTopic.slug}/`}>
              More on {featuredTopic.name} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

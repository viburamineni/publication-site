---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Find stories by headline, author, subject, or phrase."
  robots="noindex, follow"
>
  <header class="page-shell page-header">
    <h1 class="page-title">Search the edition</h1>
    <p class="page-description">Find stories by headline, author, subject, or phrase.</p>
  </header>
  <section class="page-shell" style="padding-bottom: var(--space-7);">
    <form class="search-form" role="search" id="search-form">
      <label for="search-query" class="visually-hidden">Search articles</label>
      <input
        id="search-query"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Headline, author, subject, or phrase"
      />
      <button type="submit">Search</button>
    </form>
    <p id="search-status" role="status" aria-live="polite">Enter a search term.</p>
    <div class="search-results archive-list" id="search-results"></div>
  </section>

  <script is:inline type="module">
    const form = document.querySelector('#search-form');
    const input = document.querySelector('#search-query');
    const status = document.querySelector('#search-status');
    const results = document.querySelector('#search-results');

    const escapeHtml = (value) =>
      String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const runSearch = async (query) => {
      if (!query.trim()) {
        results.replaceChildren();
        status.textContent = 'Enter a search term.';
        return;
      }

      status.textContent = 'Searching…';
      try {
        const pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
        const search = await pagefind.search(query);
        const data = (await Promise.all(search.results.slice(0, 31).map((result) => result.data())))
          .filter((item) => !item.url.includes('/__search-anchor/'))
          .slice(0, 30);
        status.textContent = `${data.length} result${data.length === 1 ? '' : 's'} for “${query}”.`;
        results.innerHTML = data
          .map(
            (item) => `
              <article class="archive-row">
                <div class="story-meta">
                  <span>${escapeHtml(item.meta.type || 'Article')}</span>
                  ${
                    item.meta.category &&
                    item.meta.category.toLocaleLowerCase() !==
                      (item.meta.type || 'Article').toLocaleLowerCase()
                      ? `<span>${escapeHtml(item.meta.category)}</span>`
                      : ''
                  }
                </div>
                <div>
                  <h2><a href="${escapeHtml(item.url)}">${escapeHtml(item.meta.title || item.url)}</a></h2>
                  <p class="card-dek">${item.excerpt}</p>
                </div>
                <div class="story-meta">
                  <span>${escapeHtml(item.meta.author || '')}</span>
                  <span>${escapeHtml(item.meta.date || '')}</span>
                </div>
              </article>`,
          )
          .join('');
      } catch {
        status.textContent = 'Search is temporarily unavailable. Please try again later.';
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value;
      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set('q', query);
      } else {
        url.searchParams.delete('q');
      }
      history.replaceState({}, '', url);
      runSearch(query);
    });

    const initialQuery = new URL(window.location.href).searchParams.get('q') || '';
    input.value = initialQuery;
    if (initialQuery) runSearch(initialQuery);
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Find stories by headline, author, subject, or phrase."
  robots="noindex, follow"
>
  <header class="page-shell page-header">
    <h1 class="page-title">Search the edition</h1>
    <p class="page-description">Find stories by headline, author, subject, or phrase.</p>
  </header>
  <section class="page-shell" style="padding-bottom: var(--space-7);">
    <form class="search-form" role="search" id="search-form">
      <label for="search-query" class="visually-hidden">Search articles</label>
      <input
        id="search-query"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Headline, author, subject, or phrase"
      />
      <button type="submit">Search</button>
    </form>
    <p id="search-status" role="status" aria-live="polite">Enter a search term.</p>
    <div class="search-results archive-list" id="search-results"></div>
  </section>

  <script is:inline type="module">
    const form = document.querySelector('#search-form');
    const input = document.querySelector('#search-query');
    const status = document.querySelector('#search-status');
    const results = document.querySelector('#search-results');

    const createStoryMeta = (...values) => {
      const meta = document.createElement('div');
      meta.className = 'story-meta';
      for (const value of values) {
        const span = document.createElement('span');
        span.textContent = value;
        meta.append(span);
      }
      return meta;
    };

    const createExcerpt = (value) => {
      const excerpt = document.createElement('p');
      excerpt.className = 'card-dek';
      let highlight = null;

      for (const token of String(value).split(/(<mark>|<\/mark>)/g)) {
        if (token === '<mark>' && !highlight) {
          highlight = document.createElement('mark');
          excerpt.append(highlight);
        } else if (token === '</mark>' && highlight) {
          highlight = null;
        } else {
          (highlight || excerpt).append(document.createTextNode(token));
        }
      }

      return excerpt;
    };

    const createSearchResult = (item) => {
      const article = document.createElement('article');
      article.className = 'archive-row';

      const type = item.meta.type || 'Article';
      const category = item.meta.category;
      article.append(
        createStoryMeta(
          type,
          ...(category && category.toLocaleLowerCase() !== type.toLocaleLowerCase()
            ? [category]
            : []),
        ),
      );

      const content = document.createElement('div');
      const heading = document.createElement('h2');
      const link = document.createElement('a');
      link.href = item.url;
      link.textContent = item.meta.title || item.url;
      heading.append(link);
      content.append(heading, createExcerpt(item.excerpt));

      article.append(content, createStoryMeta(item.meta.author || '', item.meta.date || ''));
      return article;
    };

    const runSearch = async (query) => {
      if (!query.trim()) {
        results.replaceChildren();
        status.textContent = 'Enter a search term.';
        return;
      }

      status.textContent = 'Searching…';
      try {
        const pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
        const search = await pagefind.search(query);
        const data = (await Promise.all(search.results.slice(0, 31).map((result) => result.data())))
          .filter((item) => !item.url.includes('/__search-anchor/'))
          .slice(0, 30);
        status.textContent = `${data.length} result${data.length === 1 ? '' : 's'} for “${query}”.`;
        results.replaceChildren(...data.map(createSearchResult));
      } catch {
        status.textContent = 'Search is temporarily unavailable. Please try again later.';
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value;
      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set('q', query);
      } else {
        url.searchParams.delete('q');
      }
      history.replaceState({}, '', url);
      runSearch(query);
    });

    const initialQuery = new URL(window.location.href).searchParams.get('q') || '';
    input.value = initialQuery;
    if (initialQuery) runSearch(initialQuery);
  </script>
</BaseLayout>

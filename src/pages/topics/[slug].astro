---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { publication } from '../../contentful/data';
import { approvedArticles } from '../../utilities/content';

export function getStaticPaths() {
  return publication.topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const articles = approvedArticles(publication).filter(
  (article) => article.topicIds.includes(topic.id) || topic.relatedArticleIds.includes(article.id),
);
---

<ArchiveLayout title={topic.name} description={topic.summary} articles={articles} />
